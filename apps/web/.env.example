# Copy to .env.local for local Next.js (never commit real secrets).
# Full variable list lives at repo-root .env.example.

DATABASE_URL=postgresql://fhuk:fhuk@localhost:5432/fhuk_land_finder
# Production (Vercel): pooled Neon/Supabase/Vercel Postgres URL with sslmode=require

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NEXT_PUBLIC_APP_NAME=FHUK Land Finder

# Meta Lead Ads (Facebook + Instagram share webhook) — see root .env.example
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_SECRET=
FACEBOOK_ALLOW_SIMULATE=false

# TikTok Lead Generation webhook / fetch
TIKTOK_VERIFY_TOKEN=
TIKTOK_ACCESS_TOKEN=
TIKTOK_APP_SECRET=
TIKTOK_ADVERTISER_ID=
TIKTOK_ALLOW_SIMULATE=false

# Twilio live dials (default off — PECR consent required per lead)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_PUBLIC_BASE_URL=
TWILIO_LIVE_DIALS=false

# Owner email on call QUALIFIED (never emails the seller)
NOTIFY_EMAIL_ENABLED=false
NOTIFY_EMAIL_MODE=dry-run
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=land-finder@example.com
NOTIFY_EMAIL_PROVIDER=resend
OWNER_NOTIFY_EMAIL=
RESEND_API_KEY=
