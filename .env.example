# PostgreSQL (required for --write / live dashboard from DB)
# Local example:
DATABASE_URL=postgresql://fhuk:fhuk@localhost:5432/fhuk_land_finder
# Vercel / Neon / Supabase: use the *pooled* URL and require TLS, e.g.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Do not commit real credentials. Set the same name in the Vercel project env.
# Optional: PGSSL=require  PG_POOL_MAX=1  (defaults are serverless-friendly on Vercel)

# OpenAI (collector extraction / scoring + optional web paste analysis).
# Without a key, heuristic fallback is used. Optional on Vercel.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Next.js web app (Vercel Root Directory = apps/web)
NEXT_PUBLIC_APP_NAME=FHUK Land Finder
# apps/web reads DATABASE_URL server-side for the leads list/detail.

# Collector
# Keyword geography: all | greater-manchester | west-yorkshire | merseyside |
#   lancashire | cheshire | west-midlands (comma-separated ok)
COLLECTOR_REGION=all
COLLECTOR_DRY_RUN=true
# Search provider: auto | google | bing | reddit | forums | classifieds |
#   gumtree | preloved | freeads | auctions | auctionhouse | sdl | eg |
#   plotfinder | plotbrowser | recorded | fixtures | stub
# auto = google (if keys) → bing (if key) → recorded (offline sample)
# reddit/forums/classifieds/auctions are explicit — not selected by auto
SEARCH_PROVIDER=auto

# Google Programmable Search (Custom Search JSON API) — collector host only
# NOT used by the Vercel web app. Required for live google / auto / *_LIVE CSE.
# Create: Cloud API key + Programmable Search engine ID (cx).
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Bing Web Search API v7 — optional (collector host only)
BING_SEARCH_API_KEY=

# Reddit official API (OAuth client credentials) — collector host only
# NOT used by Vercel. Without id+secret, --provider reddit uses recorded sample.
# Create at https://www.reddit.com/prefs/apps (script or web app).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=fhuk-land-finder/0.1 (by your-reddit-username)
# Comma-separated subreddits (default includes manchester,leeds,Liverpool,birmingham)
REDDIT_SUBREDDITS=
# Set true to try unauthenticated public .json search before recorded fallback
REDDIT_ALLOW_PUBLIC_JSON=false

# UK forums recorded sample override (optional)
FORUMS_RECORDED_PATH=

# Classifieds (Gumtree / Preloved / Freeads) — offline recorded by default
# Live path uses Google CSE site: filters only (no HTML scrape of listing sites)
CLASSIFIEDS_RECORDED_PATH=
CLASSIFIEDS_SITES=gumtree,preloved,freeads
CLASSIFIEDS_LIVE=false
# When CLASSIFIEDS_LIVE=true, also set GOOGLE_CSE_API_KEY + GOOGLE_CSE_CX above

# Auctions + specialist land (Auction House / SDL / EG / Plotfinder / PlotBrowser)
# Offline recorded by default. Live = Google CSE site: only (no HTML scrape).
AUCTIONS_RECORDED_PATH=
AUCTIONS_SITES=auctionhouse,sdl,eg,plotfinder,plotbrowser
AUCTIONS_LIVE=false
# When AUCTIONS_LIVE=true, also set GOOGLE_CSE_API_KEY + GOOGLE_CSE_CX above

# Facebook URL paste (compliant — no scrape): dashboard /paste and
# `fhuk-collector analyze-paste`. Distinct from Instant Form below.

# --- Facebook Instant Form (Lead Ads) — /facebook + /api/facebook/leadgen ---
# Webhook verify token (Meta hub.verify_token). No secrets in git.
FACEBOOK_VERIFY_TOKEN=
# Page access token used to fetch lead answers from Graph.
FACEBOOK_PAGE_ACCESS_TOKEN=
# Optional: verify X-Hub-Signature-256 on webhook POSTs.
FACEBOOK_APP_SECRET=
# Production gate for POST /api/facebook/leads/simulate (dev always allowed).
FACEBOOK_ALLOW_SIMULATE=false

# --- Twilio (consent-gated live dials; default OFF) ---
# PECR: only dial Instant Form leads with consent_to_call=true.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public HTTPS base for TwiML + status callbacks (e.g. https://your.app).
TWILIO_PUBLIC_BASE_URL=
# Must be exactly "true" to allow POST /api/calls/:id/dial. Keep false until counsel OK.
TWILIO_LIVE_DIALS=false

# --- Email lead notifications (Strong / Investigate on new save) ---
# Fired when a *new* qualifying lead is written (collector --write or paste save).
NOTIFY_EMAIL_ENABLED=false
# dry-run = log the email payload (no send). send = deliver via provider.
NOTIFY_EMAIL_MODE=dry-run
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=land-finder@example.com
# smtp | resend | sendgrid
NOTIFY_EMAIL_PROVIDER=smtp
# Owner-only QUALIFIED call alert (solar-compatible name). Falls back to NOTIFY_EMAIL_TO.
# Customer / seller is never emailed from the call-qualify flow.
OWNER_NOTIFY_EMAIL=

# SMTP (collector --write path; Python smtplib)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
# Optional HTTP bridge if the Next.js paste path must use SMTP
SMTP_HTTP_BRIDGE_URL=

# Resend (https://resend.com) — good for the Next.js paste save path
RESEND_API_KEY=

# SendGrid
SENDGRID_API_KEY=

# No unofficial Facebook scrapers. No paid mapping/planning APIs.
