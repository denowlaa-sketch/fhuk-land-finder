# PostgreSQL
DATABASE_URL=postgresql://fhuk:fhuk@localhost:5432/fhuk_land_finder

# OpenAI (collector extraction / scoring)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Next.js web app
NEXT_PUBLIC_APP_NAME=FHUK Land Finder
# Server-side DB for the dashboard (same as DATABASE_URL)
# DATABASE_URL is read by apps/web when querying leads.

# Collector
COLLECTOR_REGION=greater-manchester
COLLECTOR_DRY_RUN=true
# Stub search only in Phase 0 — no paid search API keys required.
